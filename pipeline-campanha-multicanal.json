      "type": "@n8n/n8n-nodes-langchain.lmChatOpenAi",
      "typeVersion": 1.2,
      "position": [
        1580,
        520
      ],
      "credentials": {
        "openAiApi": {
          "id": "SUBSTITUIR-ID-CREDENCIAL-OPENAI",
          "name": "OpenAI API"
        }

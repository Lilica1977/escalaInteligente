    },
    {
      "parameters": {
        "sessionIdType": "customKey",
        "sessionKey": "agente4_validador_session",
        "contextWindowLength": 10
      },
      "id": "n-mem4",
      "name": "Memoria Agente 4",
      "type": "@n8n/n8n-nodes-langchain.memoryBufferWindow",
      "typeVersion": 1.3,
      "position": [
        1780,
        520
      ]
    },
    {
      "parameters": {
        "jsCode": "const output = $input.first().json.output;\nconst briefing = $('Formatar Para Agente 4').first().json.briefing_analisado;\nconst copy = $('Formatar Para Agente 4').first().json.copy_criado;\nconst imagens = $('Formatar Para Agente 4').first().json.imagens_criadas;\n\nlet validacao;\ntry {\n  validacao = JSON.parse(output);\n} catch(e) {\n  const match = output.match(/```json([\\s\\S]*?)```/);\n  if (match) {\n    try { validacao = JSON.parse(match[1].trim()); }\n    catch(e2) { validacao = { aprovado: false, veredito: 'ERRO_PARSE', raw: output }; }\n  } else {\n    validacao = { aprovado: false, veredito: 'ERRO_PARSE', raw: output };\n  }\n}\n\nreturn [{ json: {\n  validacao,\n  aprovado: validacao.aprovado === true,\n  briefing_analisado: briefing,\n  copy_criado: copy,\n  imagens_criadas: imagens\n}}];"
      },
      "id": "n-parse-val",
      "name": "Parsear Validacao",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1920,
        300
      ]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict"
          },
          "conditions": [
            {
              "id": "cond-aprovado-uuid-001",
              "leftValue": "={{ $json.aprovado }}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "equals"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
